/* ============================================================================
   SINGLE ROSTER MODE
   ============================================================================ */
(function(){
  const rawPaste = document.getElementById('rawPaste');
  const teamName = document.getElementById('teamName');
  const teamTricode = document.getElementById('teamTricode');
  const tricodeRow = document.getElementById('tricodeRow');
  const optFull = document.getElementById('optFull');
  const optLast = document.getElementById('optLast');
  const optTricode = document.getElementById('optTricode');
  const optTricodeNum = document.getElementById('optTricodeNum');
  const msg = document.getElementById('msg');
  const previewWrap = document.getElementById('previewWrap');
  const downloadBtn = document.getElementById('downloadBtn');
  const optAway = document.getElementById('optAway');
  const optHome = document.getElementById('optHome');
  const countRaw = document.getElementById('countRaw');

  let players = [];

  function getFormat(){
    return document.querySelector('input[name=fmt]:checked').value;
  }
  function getNameFormat(){
    return document.querySelector('input[name=nameFmt]:checked').value;
  }

  document.querySelectorAll('input[name=nameFmt]').forEach(r => {
    r.addEventListener('change', () => {
      const val = getNameFormat();
      optFull.classList.toggle('active', val === 'full');
      optLast.classList.toggle('active', val === 'last');
      optTricode.classList.toggle('active', val === 'tricode');
      optTricodeNum.classList.toggle('active', val === 'tricodenum');
      tricodeRow.style.display = (val === 'tricode' || val === 'tricodenum') ? 'flex' : 'none';
      updateMsgAndButton();
    });
  });

  document.querySelectorAll('input[name=fmt]').forEach(r => {
    r.addEventListener('change', () => {
      optAway.classList.toggle('active', getFormat() === 'away');
      optHome.classList.toggle('active', getFormat() === 'home');
      updateMsgAndButton();
    });
  });

  function renderPreview(){
    if(players.length === 0){
      previewWrap.innerHTML = '<span style="color:#5c6773;">Paste roster data above to preview.</span>';
      return;
    }
    let html = '<table class="preview"><thead><tr><th>Num</th><th>Name</th><th>Pos</th></tr></thead><tbody>';
    players.forEach((p, idx) => {
      html += `<tr>
        <td contenteditable="true" data-idx="${idx}" data-field="num">${p.num}</td>
        <td contenteditable="true" data-idx="${idx}" data-field="name">${p.name}</td>
        <td contenteditable="true" data-idx="${idx}" data-field="pos">${p.pos}</td>
      </tr>`;
    });
    html += '</tbody></table>';
    previewWrap.innerHTML = html;

    previewWrap.querySelectorAll('[contenteditable]').forEach(cell => {
      cell.addEventListener('blur', () => {
        const idx = +cell.dataset.idx;
        const field = cell.dataset.field;
        players[idx][field] = cell.textContent.trim();
        updateMsgAndButton();
      });
    });
  }

  function updateMsgAndButton(){
    const team = teamName.value.trim();
    const nameFmt = getNameFormat();
    countRaw.textContent = players.length + ' player' + (players.length === 1 ? '' : 's') + ' detected';

    if(players.length === 0){
      msg.textContent = '';
      msg.className = 'msg';
      downloadBtn.disabled = true;
      return;
    }
    if(!team){
      msg.textContent = 'Enter a team name to enable download.';
      msg.className = 'msg error';
      downloadBtn.disabled = true;
      return;
    }
    if((nameFmt === 'tricode' || nameFmt === 'tricodenum') && !teamTricode.value.trim()){
      msg.textContent = 'Enter a team tricode to enable download.';
      msg.className = 'msg error';
      downloadBtn.disabled = true;
      return;
    }
    msg.textContent = `${players.length} players ready · ${team}`;
    msg.className = 'msg ok';
    downloadBtn.disabled = false;
  }

  function handleRawInput(){
    players = parseRoster(rawPaste.value);
    renderPreview();
    updateMsgAndButton();
  }

  downloadBtn.addEventListener('click', () => {
    const team = teamName.value.trim();
    const fmt = getFormat();
    const nameFmt = getNameFormat();
    const tricode = teamTricode.value.trim().toUpperCase();
    const csv = buildRosterCsv(team, players, fmt, nameFmt, tricode);
    const filename = team.replace(/[^a-z0-9]+/gi, '_') || 'roster';
    triggerDownload(filename + '.csv', csv);
  });

  rawPaste.addEventListener('input', handleRawInput);
  teamName.addEventListener('input', updateMsgAndButton);
  teamTricode.addEventListener('input', updateMsgAndButton);
  updateMsgAndButton();
})();

/* ============================================================================
   GAME SETUP MODE
   ============================================================================ */
(function(){
  const sportSelect = document.getElementById('sportSelect');
  const tagsInput = document.getElementById('tagsInput');
  const countTags = document.getElementById('countTags');
  const loadPresetBtn = document.getElementById('loadPresetBtn');
  const generateBtn = document.getElementById('generateBtn');
  const gameMsg = document.getElementById('gameMsg');

  const gOptFull = document.getElementById('gOptFull');
  const gOptLast = document.getElementById('gOptLast');
  const gOptTricode = document.getElementById('gOptTricode');
  const gOptTricodeNum = document.getElementById('gOptTricodeNum');
  const gOptAway = document.getElementById('gOptAway');
  const gOptHome = document.getElementById('gOptHome');

  function getGFormat(){
    return document.querySelector('input[name=gFmt]:checked').value;
  }
  function getGNameFormat(){
    return document.querySelector('input[name=gNameFmt]:checked').value;
  }

  const SPORT_TAG_PRESETS = {
    football: ["RUSH","PASS","INC","TD","FG","FGM","XP","XPM","2PT","PUNT","KO","OSK","INT","FUM","FR","SACK","SAF","TB","FC","KR","PR","1ST","3RD","4TH","TOD","PEN","FS","HOLD","PI","TO"],
    basketball: ["2PT","3PT","FT","AST","REB","STL","BLK","TO","FOUL","TIMEOUT"],
    soccer: ["GOAL","ASSIST","SHOT","SAVE","FOUL","YELLOW","RED","CORNER","OFFSIDE","PK","SUB"],
    volleyball: ["KILL","BLOCK","ACE","DIG","ASSIST","ERROR","TIMEOUT","SUB"],
    baseball: ["HIT","SINGLE","DOUBLE","TRIPLE","HR","RBI","K","BB","ERROR","STEAL","DP"],
    softball: ["HIT","SINGLE","DOUBLE","TRIPLE","HR","RBI","K","BB","ERROR","STEAL","DP"],
    lacrosse: ["GOAL","ASSIST","SHOT","SAVE","FACEOFF","GB","TURNOVER","PENALTY"],
    fieldhockey: ["GOAL","ASSIST","SHOT","SAVE","PC","CARD"],
    hockey: ["GOAL","ASSIST","SHOT","SAVE","PENALTY","PP","PK","FACEOFF"],
    wrestling: ["PIN","TF","MD","DEC","TAKEDOWN","ESCAPE","REVERSAL","NEARFALL"],
    track: ["PR","SB","DNF","DQ","WIN","PLACE"],
    gymnastics: ["STICK","FALL","DEDUCTION","ROUTINE"],
    bowling: ["STRIKE","SPARE","GUTTER","SPLIT","OPEN"],
    tennis: ["ACE","WINNER","UNFORCED ERROR","BREAK POINT","SET POINT"]
  };

  loadPresetBtn.addEventListener('click', () => {
    const preset = SPORT_TAG_PRESETS[sportSelect.value] || [];
    tagsInput.value = preset.join('\n');
    updateTagCount();
  });

  function getTags(){
    return tagsInput.value.split(/\r?\n/).map(t => t.trim()).filter(Boolean);
  }
  function updateTagCount(){
    countTags.textContent = getTags().length + ' tags';
    updateGenerateState();
  }
  tagsInput.addEventListener('input', updateTagCount);

  // Team controller factory — one instance for home, one for away
  function makeTeamController(prefix){
    const teamNameEl = document.getElementById('teamName_' + prefix);
    const tricodeEl = document.getElementById('teamTricode_' + prefix);
    const tricodeRowEl = document.getElementById('tricodeRow_' + prefix);
    const rawPasteEl = document.getElementById('rawPaste_' + prefix);
    const previewEl = document.getElementById('previewWrap_' + prefix);
    const countEl = document.getElementById('countRaw_' + prefix);
    const msgEl = document.getElementById('msg_' + prefix);

    let players = [];

    function renderPreview(){
      if(players.length === 0){
        previewEl.innerHTML = '<span style="color:#5c6773;">Paste roster data above to preview.</span>';
        return;
      }
      let html = '<table class="preview"><thead><tr><th>Num</th><th>Name</th><th>Pos</th></tr></thead><tbody>';
      players.forEach((p, idx) => {
        html += `<tr>
          <td contenteditable="true" data-idx="${idx}" data-field="num">${p.num}</td>
          <td contenteditable="true" data-idx="${idx}" data-field="name">${p.name}</td>
          <td contenteditable="true" data-idx="${idx}" data-field="pos">${p.pos}</td>
        </tr>`;
      });
      html += '</tbody></table>';
      previewEl.innerHTML = html;

      previewEl.querySelectorAll('[contenteditable]').forEach(cell => {
        cell.addEventListener('blur', () => {
          const idx = +cell.dataset.idx;
          const field = cell.dataset.field;
          players[idx][field] = cell.textContent.trim();
          updateMsg();
        });
      });
    }

    function updateMsg(){
      const team = teamNameEl.value.trim();
      countEl.textContent = players.length + ' player' + (players.length === 1 ? '' : 's') + ' detected';
      if(players.length === 0){
        msgEl.textContent = '';
        msgEl.className = 'msg';
      } else if(!team){
        msgEl.textContent = 'Enter a team name.';
        msgEl.className = 'msg error';
      } else if((getGNameFormat() === 'tricode' || getGNameFormat() === 'tricodenum') && !tricodeEl.value.trim()){
        msgEl.textContent = 'Enter a tricode.';
        msgEl.className = 'msg error';
      } else {
        msgEl.textContent = `${players.length} players ready · ${team}`;
        msgEl.className = 'msg ok';
      }
      updateGenerateState();
    }

    rawPasteEl.addEventListener('input', () => {
      players = parseRoster(rawPasteEl.value);
      renderPreview();
      updateMsg();
    });
    teamNameEl.addEventListener('input', updateMsg);
    tricodeEl.addEventListener('input', updateMsg);

    return {
      isReady(){
        const team = teamNameEl.value.trim();
        if(players.length === 0 || !team) return false;
        if((getGNameFormat() === 'tricode' || getGNameFormat() === 'tricodenum') && !tricodeEl.value.trim()) return false;
        return true;
      },
      buildCsv(){
        const team = teamNameEl.value.trim();
        const tricode = tricodeEl.value.trim().toUpperCase();
        return buildRosterCsv(team, players, getGFormat(), getGNameFormat(), tricode);
      },
      teamFileLabel(){
        return (teamNameEl.value.trim().replace(/[^a-z0-9]+/gi, '_') || prefix);
      },
      refreshMsg: updateMsg,
      toggleTricodeRow(show){
        tricodeRowEl.style.display = show ? 'flex' : 'none';
      }
    };
  }

  const homeTeam = makeTeamController('home');
  const awayTeam = makeTeamController('away');

  document.querySelectorAll('input[name=gNameFmt]').forEach(r => {
    r.addEventListener('change', () => {
      const val = getGNameFormat();
      gOptFull.classList.toggle('active', val === 'full');
      gOptLast.classList.toggle('active', val === 'last');
      gOptTricode.classList.toggle('active', val === 'tricode');
      gOptTricodeNum.classList.toggle('active', val === 'tricodenum');
      const show = (val === 'tricode' || val === 'tricodenum');
      homeTeam.toggleTricodeRow(show);
      awayTeam.toggleTricodeRow(show);
      homeTeam.refreshMsg();
      awayTeam.refreshMsg();
    });
  });

  document.querySelectorAll('input[name=gFmt]').forEach(r => {
    r.addEventListener('change', () => {
      gOptAway.classList.toggle('active', getGFormat() === 'away');
      gOptHome.classList.toggle('active', getGFormat() === 'home');
    });
  });

  function updateGenerateState(){
    const homeReady = homeTeam.isReady();
    const awayReady = awayTeam.isReady();
    if(homeReady && awayReady){
      gameMsg.textContent = 'Ready to generate: home roster, away roster' + (getTags().length ? ', and play tags.' : '.');
      gameMsg.className = 'msg ok';
      generateBtn.disabled = false;
    } else {
      const missing = [];
      if(!homeReady) missing.push('home team');
      if(!awayReady) missing.push('away team');
      gameMsg.textContent = 'Fill in ' + missing.join(' and ') + ' to generate the game package.';
      gameMsg.className = 'msg';
      generateBtn.disabled = true;
    }
  }

  generateBtn.addEventListener('click', () => {
    const homeLabel = homeTeam.teamFileLabel();
    const awayLabel = awayTeam.teamFileLabel();
    triggerDownload(`Home_${homeLabel}.csv`, homeTeam.buildCsv());
    triggerDownload(`Away_${awayLabel}.csv`, awayTeam.buildCsv());

    const tags = getTags();
    if(tags.length > 0){
      let tagsCsv = `${sportSelect.options[sportSelect.selectedIndex].text} Play Tags\r\n`;
      tags.forEach((t, idx) => {
        tagsCsv += `${idx + 1},${csvField(t)}\r\n`;
      });
      triggerDownload(`PlayTags_${sportSelect.value}.csv`, tagsCsv);
    }
  });

  updateGenerateState();
})();
</script>
